DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Obligatoria e independiente: generar con python -m api.configurar_clave_jwt.
# Minimo 32 bytes aleatorios; nunca versionar la clave real.
JWT_SIGNING_KEY=

# SQLite local por defecto. MySQL y MariaDB usan el mismo backend de Django.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# En EC2: DEBUG=False, hosts reales y origen HTTPS (incluye https://).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Cambiar a True cuando HTTPS este configurado.
DJANGO_SECURE_SSL_REDIRECT=False
# Sin definir, las cookies seguras se activan cuando DEBUG=False.
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=0
# No activar sin confirmar HTTPS en TODOS los subdominios y evaluar preload.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Solo True detras de un proxy propio que sobrescriba X-Forwarded-Proto.
DJANGO_TRUST_PROXY=False
